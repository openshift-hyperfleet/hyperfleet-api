{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "schedule": [
    "* * * * 1"
  ],
  "gomod": {
    "packageRules": [
      {
        "matchUpdateTypes": [
          "digest"
        ],
        "enabled": false
      },
      {
        "matchDepTypes": [
          "indirect"
        ],
        "enabled": false
      }
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "pin"
      ],
      "groupName": "gomod non-major",
      "addLabels": [
        "lgtm",
        "approved"
      ],
      "automerge": false,
      "platformAutomerge": false
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "gomod major",
      "addLabels": [
        "manual-review-required"
      ]
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "groupName": "docker image updates"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "registry.access.redhat.com/ubi9/go-toolset"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "ubi9 go-toolset",
      "addLabels": [
        "lgtm",
        "approved"
      ],
      "automerge": false,
      "platformAutomerge": false
    },
    {
      "matchManagers": [
        "tekton"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "pin",
        "digest"
      ],
      "groupName": "Konflux references non-major",
      "addLabels": [
        "lgtm",
        "approved"
      ],
      "automerge": false,
      "platformAutomerge": false
    },
    {
      "matchManagers": [
        "tekton"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "Konflux references major",
      "addLabels": [
        "manual-review-required"
      ]
    }
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ]
}
